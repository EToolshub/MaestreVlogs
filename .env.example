# Copia este archivo como .env.local para desarrollo local.
# En producción, crea estas variables en Vercel → Settings → Environment Variables
# y pulsa Redeploy después de añadirlas.

# 1) YouTube Data API v3 (Google Cloud → Credenciales → Clave de API).
# Suscriptores, vistas y último video cada minuto; galería cada 5 minutos.
YOUTUBE_API_KEY=

# 2) YouTube Analytics (Google Cloud → Credenciales → ID de cliente de OAuth,
# tipo "Aplicación web", redirección https://maestrevlogs.vercel.app/api/youtube/callback).
# Últimos 28 días, 12 meses, edad, países y dispositivos, cada hora.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
# Se obtiene una sola vez abriendo /api/youtube/connect?secret=ADMIN_SECRET
YOUTUBE_REFRESH_TOKEN=

# 3) Contraseña tuya para /api/youtube/connect y /api/revalidate.
# (REVALIDATE_SECRET también funciona si ya lo tenías creado.)
ADMIN_SECRET=
