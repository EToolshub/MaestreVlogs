# Copia este archivo como .env.local para desarrollo local.
# En producción, crea estas variables en Vercel → Settings → Environment Variables.

# Clave de la YouTube Data API v3 (Google Cloud). Activa los datos en vivo:
# suscriptores, vistas totales, último video y lista de videos.
# Sin ella, la web usa el RSS público del canal y, si falla, los datos guardados.
YOUTUBE_API_KEY=

# Opcional: clave para forzar la actualización sin esperar 6 horas
# visitando /api/revalidate?secret=ESTA_CLAVE
REVALIDATE_SECRET=
